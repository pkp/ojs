msgid "emails.passwordResetConfirm.subject"
msgstr "ยืนยันการรีเซ็ตรหัสผ่าน"

msgid "emails.userRegister.subject"
msgstr "ลงทะเบียนกับวารสาร"

msgid "emails.editorDecisionAccept.subject"
msgstr "บทความของคุณได้รับการตอบรับจาก {$contextName}"

msgid "emails.revisedVersionNotify.body"
msgstr ""
"<p>เรียน {$recipientName}</p><p>ผู้เขียนได้อัปโหลดบทความฉบับแก้ไขสำหรับ "
"<b>{$authorsShort} — "
"{$submissionTitle}</b></p><p>เนื่องจากคุณเป็นบรรณาธิการที่ได้รับมอบหมาย "
"โปรดเข้าสู่ระบบและ <a href=\"{$submissionUrl}\">ตรวจสอบฉบับแก้ไข</a> "
"จากนั้นพิจารณาตัดสินใจรับ ปฏิเสธ หรือส่งบทความเข้าสู่การประเมินเพิ่มเติม</p>"

msgid "emails.statisticsReportNotification.subject"
msgstr "กิจกรรมด้านบรรณาธิการประจำเดือน {$month} {$year}"

msgid "emails.statisticsReportNotification.body"
msgstr ""
"\n"
"{$recipientName},<br />\n"
"<br />\n"
"รายงานภาพรวมการดำเนินงานของวารสารประจำเดือน {$month} {$year} พร้อมใช้งานแล้ว "
"โดยมีสถิติสำคัญของเดือนนี้ดังนี้<br />\n"
"<ul>\n"
"<li>บทความที่ส่งเข้ามาใหม่ในเดือนนี้: {$newSubmissions}</li>\n"
"<li>บทความที่ถูกปฏิเสธในเดือนนี้: {$declinedSubmissions}</li>\n"
"<li>บทความที่ได้รับการตอบรับในเดือนนี้: {$acceptedSubmissions}</li>\n"
"<li>บทความทั้งหมดในระบบ: {$totalSubmissions}</li>\n"
"</ul>\n"
"เข้าสู่ระบบวารสารเพื่อดูรายละเอียดเพิ่มเติมเกี่ยวกับ <a href=\""
"{$editorialStatsLink}\">แนวโน้มการดำเนินงานด้านบรรณาธิการ</a> และ <a href=\""
"{$publicationStatsLink}\">สถิติบทความที่เผยแพร่</a> "
"โดยแนบรายงานแนวโน้มด้านบรรณาธิการฉบับเต็มของเดือนนี้มาพร้อมกับอีเมล<br />\n"
"<br />\n"
"ขอแสดงความนับถือ<br />\n"
"{$contextSignature}"

msgid "emails.announcement.subject"
msgstr "{$announcementTitle}"

msgid "emails.announcement.body"
msgstr ""
"<b>{$announcementTitle}</b><br />\n"
"<br />\n"
"{$announcementSummary}<br />\n"
"<br />\n"
"โปรดเยี่ยมชมเว็บไซต์ของเราเพื่ออ่าน <a href=\"{$announcementUrl}\""
">ประกาศฉบับเต็ม</a>"

msgid "emails.passwordResetConfirm.body"
msgstr ""
"เราได้รับคำขอให้รีเซ็ตรหัสผ่านของคุณสำหรับเว็บไซต์ {$siteTitle}<br />\n"
"<br />\n"
"หากคุณไม่ได้เป็นผู้ส่งคำขอนี้ โปรดเพิกเฉยต่ออีเมลฉบับนี้ "
"รหัสผ่านของคุณจะไม่ถูกเปลี่ยนแปลง <br />\n"
"<br />\n"
"หากต้องการรีเซ็ตรหัสผ่าน โปรดคลิกลิงก์ด้านล่างรีเซ็ตรหัสผ่านของฉัน: <a href="
"\"{$passwordResetUrl}\">{$passwordResetUrl}</a><br />\n"
"<br />\n"
"{$siteContactName}"

msgid "emails.userRegister.body"
msgstr ""
"{$recipientName}<br />\n"
"<br />\n"
"ขณะนี้คุณได้รับการลงทะเบียนเป็นผู้ใช้ของ {$contextName} แล้ว "
"อีเมลฉบับนี้มีชื่อผู้ใช้และรหัสผ่านสำหรับใช้ดำเนินงานกับวารสารผ่านเว็บไซต์ "
"หากไม่ต้องการเป็นผู้ใช้ของวารสารอีกต่อไป "
"คุณสามารถติดต่อฉันเพื่อขอให้นำชื่อของคุณออกจากรายชื่อผู้ใช้ได้ทุกเมื่อ<br />"
"\n"
"<br />\n"
"ชื่อผู้ใช้: {$recipientUsername}<br />\n"
"รหัสผ่าน: {$password}<br />\n"
"<br />\n"
"ขอบคุณ<br />\n"
"{$signature}"

msgid "emails.userValidateContext.subject"
msgstr "ยืนยันบัญชีของคุณ"

msgid "emails.userValidateContext.body"
msgstr ""
"{$recipientName}<br />\n"
"<br />\n"
"คุณได้สร้างบัญชีกับ {$contextName} แล้ว แต่ก่อนเริ่มใช้งาน "
"คุณต้องยืนยันอีเมลของคุณก่อน โดยคลิกลิงก์ด้านล่าง<br />\n"
"<br />\n"
"<a href=\"{$activateUrl}\">{$activateUrl}</a><br />\n"
"<br />\n"
"ขอบคุณ<br />\n"
"{$contextSignature}"

msgid "emails.userValidateSite.subject"
msgstr "ยืนยันบัญชีของคุณ"

msgid "emails.userValidateSite.body"
msgstr ""
"{$recipientName}<br />\n"
"<br />\n"
"คุณได้สร้างบัญชีกับ {$siteTitle} แล้ว แต่ก่อนเริ่มใช้งาน "
"คุณต้องยืนยันอีเมลของคุณก่อน โดยคลิกลิงก์ด้านล่าง<br />\n"
"<br />\n"
"<a href=\"{$activateUrl}\">{$activateUrl}</a><br />\n"
"<br />\n"
"ขอบคุณ<br />\n"
"{$siteSignature}"

msgid "emails.reviewerRegister.subject"
msgstr "ลงทะเบียนเป็นผู้ประเมินของ {$contextName}"

msgid "emails.reviewerRegister.body"
msgstr ""
"<p>เรียน {$recipientName}</p><p>ด้วยความเชี่ยวชาญของท่าน "
"เราได้เพิ่มชื่อของท่านไว้ในฐานข้อมูลผู้ประเมินของ {$contextName} "
"การลงทะเบียนนี้ไม่ได้เป็นการผูกมัดให้ท่านต้องรับประเมินบทความ "
"แต่ช่วยให้เราสามารถเชิญท่านให้พิจารณารับประเมินบทความได้ เมื่อได้รับคำเชิญ "
"ท่านจะสามารถดูชื่อเรื่องและบทคัดย่อของบทความก่อนตัดสินใจตอบรับหรือปฏิเสธได้ แ"
"ละท่านสามารถขอให้นำชื่อออกจากรายชื่อผู้ประเมินได้ทุกเมื่อ</p><p>เราได้จัดเตรี"
"ยมชื่อผู้ใช้และรหัสผ่านสำหรับใช้ติดต่อและดำเนินงานกับวารสารผ่านเว็บไซต์ "
"ท่านสามารถใช้บัญชีนี้เพื่อปรับปรุงข้อมูลส่วนตัว "
"รวมถึงระบุหัวข้อที่สนใจรับประเมินได้</p><p>ชื่อผู้ใช้: {$recipientUsername}"
"<br />รหัสผ่าน: {$password}</p><p>ขอบคุณ</p>{$signature}"

msgid "emails.reviewRemindAuto.body"
msgstr ""
"<p>เรียน {$recipientName}</p><p>อีเมลฉบับนี้เป็นการแจ้งเตือนอัตโนมัติจาก "
"{$contextName} เกี่ยวกับการประเมินบทความ \"{$submissionTitle}\""
"</p><p>บทความนี้มีกำหนดส่งผลการประเมินภายใน {$reviewDueDate} "
"และเรายินดีอย่างยิ่งหากได้รับผลการประเมินจากท่านโดยเร็วที่สุดเมื่อสะดวก</"
"p><p>โปรด <a href=\"{$reviewAssignmentUrl}\">เข้าสู่ระบบวารสาร</a> "
"และดำเนินการตามขั้นตอนการประเมินเพื่อดูบทความ อัปโหลดไฟล์ "
"และส่งความคิดเห็น</p><p>หากต้องการขยายระยะเวลาการประเมิน โปรดติดต่อฉัน และหวั"
"งว่าจะได้รับการตอบกลับจากท่าน</p><p>ขอขอบคุณล่วงหน้าและขอแสดงความนับถือ</p>{$"
"contextSignature}"

msgid "emails.editorDecisionAccept.body"
msgstr ""
"<p>เรียน {$recipientName}</p><p>เรายินดีแจ้งให้ทราบว่าได้ตัดสินใจรับบทความของ"
"คุณโดยไม่ต้องแก้ไขเพิ่มเติม หลังจากพิจารณาอย่างรอบคอบแล้ว บทความ "
"{$submissionTitle} มีคุณภาพตามหรือสูงกว่าเกณฑ์ที่กำหนด "
"เรามีความยินดีที่จะเผยแพร่ผลงานของคุณใน {$contextName} และขอขอบคุณที่เลือกวาร"
"สารของเราเป็นช่องทางเผยแพร่ผลงาน</p><p>บทความของคุณจะได้รับการเผยแพร่ในฉบับหน"
"ึ่งของ {$contextName} ต่อไป และสามารถนำไปเพิ่มในรายการผลงานตีพิมพ์ของคุณได้ ข"
"อแสดงความยินดีที่บทความของคุณได้ผ่านมาถึงขั้นตอนนี้</p><p>จากนี้บทความจะเข้าส"
"ู่ขั้นตอนการตรวจแก้ต้นฉบับและจัดรูปแบบเพื่อเตรียมเผยแพร่</p><p>คุณจะได้รับคำแ"
"นะนำเพิ่มเติมในเร็ว ๆ นี้</p><p>หากมีข้อสงสัย โปรดติดต่อฉันผ่าน <a href=\""
"{$authorSubmissionUrl}\">หน้าจัดการบทความ</a> "
"ของคุณ</p><p>ขอแสดงความนับถือ</p>{$signature}"

msgid "emails.editorDecisionSkipReview.subject"
msgstr "บทความของคุณถูกส่งเข้าสู่ขั้นตอนตรวจแก้ต้นฉบับแล้ว"

msgid "emails.editorDecisionSkipReview.body"
msgstr ""
"<p>เรียน {$recipientName}</p>\n"
"<p>เรายินดีแจ้งให้ทราบว่าได้ตัดสินใจรับบทความของคุณโดยไม่ต้องผ่านการประเมินโด"
"ยผู้ทรงคุณวุฒิ บทความ {$submissionTitle} มีคุณภาพตามเกณฑ์ที่กำหนด "
"และผลงานประเภทนี้ไม่จำเป็นต้องผ่านการประเมินโดยผู้ทรงคุณวุฒิ "
"เรามีความยินดีที่จะเผยแพร่ผลงานของคุณใน {$contextName} "
"และขอขอบคุณที่เลือกวารสารของเราเป็นช่องทางเผยแพร่ผลงาน</p>\n"
"บทความของคุณจะได้รับการเผยแพร่ในฉบับหนึ่งของ {$contextName} ต่อไป "
"และสามารถนำไปเพิ่มในรายการผลงานตีพิมพ์ของคุณได้ "
"ขอแสดงความยินดีกับความสำเร็จในขั้นตอนนี้</p>\n"
"<p>จากนี้บทความจะเข้าสู่ขั้นตอนการตรวจแก้ต้นฉบับและจัดรูปแบบเพื่อเตรียมเผยแพร"
"่</p>\n"
"<p>คุณจะได้รับคำแนะนำเพิ่มเติมในเร็ว ๆ นี้</p>\n"
"<p>หากมีข้อสงสัย โปรดติดต่อฉันผ่าน <a href=\"{$authorSubmissionUrl}\""
">หน้าจัดการบทความ</a> ของคุณ</p>\n"
"<p>ขอแสดงความนับถือ</p>\n"
"<p>{$signature}</p>\n"

msgid "emails.layoutRequest.subject"
msgstr ""
"บทความ {$submissionId} พร้อมสำหรับการจัดเตรียมเผยแพร่ใน {$contextAcronym}"

msgid "emails.layoutRequest.body"
msgstr ""
"<p>เรียน "
"{$recipientName}</p><p>มีบทความใหม่พร้อมสำหรับการจัดรูปแบบเพื่อเผยแพร่:</"
"p><p><a href=\"{$submissionUrl}\">{$submissionId} — {$submissionTitle}</"
"a><br />{$contextName}</p><ol><li>คลิก URL "
"ของบทความด้านบน</li><li>ดาวน์โหลดไฟล์ที่พร้อมสำหรับการเผยแพร่ และนำไปจัดทำไฟล"
"์เผยแพร่ตามรูปแบบของวารสาร</li><li>อัปโหลดไฟล์เผยแพร่ในส่วนการเผยแพร่ของบทควา"
"ม</li><li>ใช้การสนทนาในขั้นตอนการจัดเตรียมเผยแพร่เพื่อแจ้งบรรณาธิการว่าไฟล์เผ"
"ยแพร่พร้อมแล้ว</li></ol><p>หากขณะนี้ไม่สามารถดำเนินงานนี้ได้ หรือมีข้อสงสัย "
"โปรดติดต่อฉัน "
"ขอขอบคุณสำหรับการมีส่วนร่วมกับวารสาร</p><p>ขอแสดงความนับถือ</p>{$signature}"

msgid "emails.layoutComplete.subject"
msgstr "จัดเตรียมไฟล์เผยแพร่เสร็จแล้ว"

msgid "emails.layoutComplete.body"
msgstr ""
"<p>เรียน "
"{$recipientName}</p><p>ไฟล์เผยแพร่สำหรับบทความต่อไปนี้จัดเตรียมเรียบร้อยแล้ว "
"และพร้อมสำหรับการตรวจสอบขั้นสุดท้าย</p><p><a href=\"{$submissionUrl}\""
">{$submissionTitle}</a><br />{$contextName}</p><p>หากมีข้อสงสัย "
"โปรดติดต่อฉัน</p><p>ขอแสดงความนับถือ</p><p>{$signature}</p>"

msgid "emails.emailLink.subject"
msgstr "บทความที่คุณอาจสนใจ"

msgid "emails.emailLink.body"
msgstr ""
"คิดว่าคุณอาจสนใจบทความ \"{$submissionTitle}\" โดย {$authors} ซึ่งเผยแพร่ใน "
"{$contextName} ปีที่ {$volume} ฉบับที่ {$number} ({$year}) และอ่านได้ที่ \""
"{$submissionUrl}\""

msgid "emails.subscriptionNotify.subject"
msgstr "แจ้งข้อมูลการเป็นสมาชิก"

msgid "emails.subscriptionNotify.body"
msgstr ""
"{$recipientName}:<br />\n"
"<br />\n"
"ขณะนี้คุณได้รับการลงทะเบียนเป็นสมาชิกในระบบจัดการวารสารออนไลน์ของ "
"{$contextName} โดยมีข้อมูลการเป็นสมาชิกดังนี้:<br />\n"
"<br />\n"
"{$subscriptionType}<br />\n"
"<br />\n"
"หากต้องการเข้าถึงเนื้อหาสำหรับสมาชิกเท่านั้น โปรดเข้าสู่ระบบด้วยชื่อผู้ใช้ \""
"{$recipientUsername}\"<br />\n"
"<br />\n"
"หลังจากเข้าสู่ระบบแล้ว คุณสามารถแก้ไขข้อมูลส่วนตัวและรหัสผ่านได้ทุกเมื่อ<br "
"/>\n"
"<br />\n"
"หากเป็นสมาชิกแบบสถาบัน ผู้ใช้ภายในสถาบันไม่จำเป็นต้องเข้าสู่ระบบ "
"เนื่องจากระบบจะตรวจสอบสิทธิ์การเข้าถึงเนื้อหาสำหรับสมาชิกโดยอัตโนมัติ<br />\n"
"<br />\n"
"หากมีข้อสงสัย สามารถติดต่อฉันได้<br />\n"
"<br />\n"
"{$subscriptionSignature}"

msgid "emails.openAccessNotify.subject"
msgstr ""
"อ่านได้ฟรี: {$issueIdentification} ของ {$contextName} "
"เปิดให้เข้าถึงแบบเสรีแล้ว"

msgid "emails.openAccessNotify.body"
msgstr ""
"<p>เรียน {$recipientName}</p><p>เรายินดีแจ้งให้ทราบว่า <a href=\"{$issueUrl}"
"\">{$issueIdentification}</a> ของ {$contextName} เปิดให้เข้าถึงแบบเสรีแล้ว แล"
"ะไม่จำเป็นต้องเป็นสมาชิกเพื่ออ่านฉบับนี้อีกต่อไป</p><p>ขอขอบคุณที่ให้ความสนใจ"
"ในผลงานของเราอย่างต่อเนื่อง</p>{$contextSignature}"

msgid "emails.subscriptionBeforeExpiry.subject"
msgstr "แจ้งเตือนสมาชิกใกล้หมดอายุ"

msgid "emails.subscriptionBeforeExpiry.body"
msgstr ""
"{$recipientName}:<br />\n"
"<br />\n"
