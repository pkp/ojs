msgstr "Buttons, Menus and Forms Font"

msgid "plugins.themes.eidos.option.actionsFont.description"
msgstr "Select the font to use for interactive elements, such as buttons, navigation menus, and forms."

msgid "plugins.themes.eidos.option.highlightArticleMetadata.label"
msgstr "Article Highlight Metadata"

msgid "plugins.themes.eidos.option.highlightArticleMetadata.description"
msgstr "Select the article metadata that you want to show at the top of the article landing page."

msgid "plugins.themes.eidos.option.sidebarArticleMetadata.label"
msgstr "Article Sidebar Metadata"

msgid "plugins.themes.eidos.option.sidebarArticleMetadata.description"
msgstr "Select the article metadata that you want to show in the sidebar on the article landing page."

msgid "plugins.themes.eidos.option.shareOptions.label"
msgstr "Social Share Options"

msgid "plugins.themes.eidos.option.shareOptions.description"
msgstr "Choose which options readers should have to share an article from the article landing page. Select none of the options to hide the share button."

msgid "plugins.themes.eidos.option.issueToc.label"
msgstr "Issue Table of Contents"

msgid "plugins.themes.eidos.option.issueToc.description"
msgstr "Select how to display articles in the issue table of contents."

msgid "plugins.themes.eidos.option.issueToc.default"
msgstr "Don't show a link to download galleys or article cover images."

msgid "plugins.themes.eidos.option.issueToc.galleys"
msgstr "Show a link to download galleys."

msgid "plugins.themes.eidos.option.issueToc.covers"
msgstr "Show the article cover image."

