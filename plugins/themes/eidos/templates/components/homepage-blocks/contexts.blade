@if (count($journals))
    <x-homepage-blocks.default slug="contexts">
        <div class="homepage-block-contexts-header">
            <h2 class="homepage-block-contexts-title">
                {{ __('search.allJournals') }}
            </h2>
            <div class="homepage-block-contexts-desc">
                {!!
                    ViewHelper::sanitizeHtml(
                        __('plugins.themes.eidos.option.homepageBlocks.contexts.desc', [
                            'url' => ViewHelper::url(['page' => 'search'])
