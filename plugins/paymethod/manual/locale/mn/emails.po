msgid "emails.manualPaymentNotification.subject"
msgstr "Гар аргаар төлбөр хийх мэдэгдэл"

msgid "emailTemplate.variable.manualPaymentPlugin.senderUsername"
msgstr "Төлбөр хийсэн хэрэглэгчийн нэр"

msgid "emails.manualPaymentNotification.description"
msgstr ""
"Энэхүү имэйл загварыг гарын авлагын төлбөр хүссэн тухай тэмдэглэлийн "
"менежерийн харилцагчдад мэдэгдэхэд ашигладаг."

msgid "emails.manualPaymentNotification.body"
msgstr ""
"{$contextName} сэтгүүл болон \"{$senderUsername}\" хэрэглэгчийн хувьд гараар "
"төлбөр хийх шаардлагатай.<br />\n"
"<br />\n"
"Төлбөр төлж буй зүйл нь \"{$paymentName}\" юм.<br />\n"
"Үнэ нь {$paymentAmount} ({$paymentCurrencyCode}).<br />\n"
"<br />\n"
"Энэ имэйлийг Open Journal Systems-ийн Гараар төлбөр хийх залгаас үүсгэсэн."
