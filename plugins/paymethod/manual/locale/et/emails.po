msgid "emails.manualPaymentNotification.subject"
msgstr "Käsitsi makse teade"

msgid "emails.manualPaymentNotification.body"
msgstr ""
"Käsitsi makset vajatakse ajakirja {$contextName} ja kasutaja {senderName} ("
"username &quot;{$senderUsername}&quot;) jaoks.<br />\n"
"<br />\n"
"Makstakse &quot;{$paymentName}&quot; jaoks.<br />\n"
"Summa on {$paymentAmount} ({$paymentCurrencyCode}).<br />\n"
"<br />\n"
"See e-kiri on loodud Open Journal Systems käsitsi makse pluginaga."

msgid "emails.manualPaymentNotification.description"
msgstr ""
"Seda e-kirja malli kasutatakse ajakirja haldurile teatamiseks, et soovitakse "
"käsitsi makset."

msgid "emailTemplate.variable.manualPaymentPlugin.senderUsername"
msgstr "Kasutaja kasutajanimi, kes makse sooritas"
