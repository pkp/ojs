# Environment for the OJS Playwright e2e suite.
#
#   cp .env.playwright.example .env.playwright
#
# playwright/playwright.config.js reads this file; anything already exported in
# the shell wins, so `TEST_API_KEY=other npx playwright test …` still overrides.
# Never commit .env.playwright — it names a local database and a shared secret.

# Which configuration file the PHP servers and tools run against. This is the
# whole switch between the development install and the test install: the app
# honours PKP_CONFIG_FILE wherever it resolves its configuration.
PKP_CONFIG_FILE=/absolute/path/to/ojs/config.test.inc.php

# Enables and gates /api/v1/_test/*. The namespace answers 404 unless this
# variable is in the SERVER's process environment, and 403 unless the request's
# X-Test-Key header matches. Any non-empty value works locally.
TEST_API_KEY=playwright-test-key

# Port of parallel worker 0. Each worker gets its own PHP server at
# PLAYWRIGHT_BASE_PORT + parallelIndex, because `php -S` serves one request at
# a time. OJS 8000 · OMP 8100 · OPS 8200.
PLAYWRIGHT_BASE_PORT=8000

# How many parallel workers — and therefore how many PHP servers to start.
PLAYWRIGHT_WORKERS=2

# Mailpit, shared by every worker and by all three app fleets. Scope every mail
# assertion by a unique throwaway recipient address; never clear the inbox.
#   brew services start mailpit
MAILPIT_URL=http://127.0.0.1:8025
